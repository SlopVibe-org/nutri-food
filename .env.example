# NutriFood Environment Configuration
# Copy this file to .env and fill in your values before running: docker compose up -d

# ─── Security ───
# Generate a new one: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme

# JWT token expiry in hours (2160 = 90 days)
JWT_EXPIRY_HOURS=2160

# ─── Email (SMTP) ───
# Used for welcome emails and password reset links
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=
MAIL_FROM=noreply@example.com

# ─── App ───
# Public URL where the app is accessible (used in email links)
APP_URL=https://localhost/nutri-food/
